<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<GridPane xmlns:fx="http://javafx.com/fxml/1" gridLinesVisible="false" hgap="0.0" layoutX="0.0" prefHeight="-1.0"
          prefWidth="-1.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/8"
          fx:controller="de.weigend.wfx.platform.impl.ProgressController">
    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0"/>
    </columnConstraints>
    <padding>
        <Insets right="10.0"/>
    </padding>
    <rowConstraints>
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
    </rowConstraints>
    <ProgressBar fx:id="progressBar" disable="false" maxWidth="1.7976931348623157E308" minHeight="-1.0"
                 prefHeight="15.0" prefWidth="-1.0" progress="0.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
        <contextMenu>
            <ContextMenu>
                <items>
                    <MenuItem mnemonicParsing="false" text="X">
                        <graphic>
                            <ProgressBar prefWidth="200.0" progress="0.0"/>
                        </graphic>
                    </MenuItem>
                    <MenuItem mnemonicParsing="false" text="X">
                        <graphic>
                            <ProgressBar prefWidth="200.0" progress="0.0"/>
                        </graphic>
                    </MenuItem>
                </items>
            </ContextMenu>
        </contextMenu>
    </ProgressBar>
    <Label fx:id="progressText" contentDisplay="CENTER" text="Working...">
        <font>
            <Font size="14.0"/>
        </font>
        <opaqueInsets>
            <Insets/>
        </opaqueInsets>
        <GridPane.margin>
            <Insets left="30.0"/>
        </GridPane.margin>
    </Label>
</GridPane>
