<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.softwareecg.wfx</groupId>
        <artifactId>wfx</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>wfx-all</artifactId>
    <packaging>jar</packaging>

    <name>WFX - All-in-One</name>
    <description>
        Aggregated JAR containing all WFX modules.
        Use this dependency if you want the complete framework in a single artifact.
    </description>

    <dependencies>
        <!-- Core modules -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>lookup</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>platform-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>platform-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>platform-runner</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>windowmanager-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>windowmanager-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>ui-utils</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>view-menu</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            Runtime dependencies - these are NOT included in the shaded JAR
            but will be transitively pulled when a user adds wfx-all as dependency
        -->

        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- JavaFX -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>

        <!-- Utilities -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Create uber-jar with all classes merged -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>true</createDependencyReducedPom>
                            <transformers>
                                <!-- Merge META-INF/services files -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- Keep license info -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <!-- Aggregate NOTICE files -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                                    <addHeader>false</addHeader>
                                </transformer>
                                <!--
                                    Replace the merged InjectExtension service file with a hand-curated
                                    version. The avaje-inject annotation processor writes
                                    'io.avaje.inject.events.spi.ObserverManagerPlugin' (a class that lives
                                    in avaje-inject.jar) into every wfx module's generated service file.
                                    When shade merges those, the resulting wfx-all entry references a class
                                    that is not bundled here (avaje-inject is excluded by artifactSet),
                                    which makes JPMS reject auto-module derivation for wfx-all.jar.
                                    The avaje-inject runtime ships its own service file with the same
                                    plugin entry, so consumers still get it transitively — we only need
                                    to advertise wfx's own DI modules.
                                -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                                    <resource>META-INF/services/io.avaje.inject.spi.InjectExtension</resource>
                                    <file>${project.basedir}/src/main/resources/META-INF/services/io.avaje.inject.spi.InjectExtension</file>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Exclude signature files -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!-- Exclude module-info to avoid conflicts -->
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                                <!--
                                    Drop the AP-generated InjectExtension service files from the wfx
                                    modules so the IncludeResourceTransformer's curated version wins.
                                -->
                                <filter>
                                    <artifact>io.softwareecg.wfx:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/services/io.avaje.inject.spi.InjectExtension</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <!-- Only include wfx modules, not third-party deps -->
                            <artifactSet>
                                <includes>
                                    <include>io.softwareecg.wfx:*</include>
                                </includes>
                            </artifactSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>

</project>
